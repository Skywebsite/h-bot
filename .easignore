# Windows system files - exclude everything in AppData
# Match from any level including absolute paths
AppData/
**/AppData/
**/AppData/**/*
AppData/Local/
**/AppData/Local/
**/AppData/Local/**/*
AppData/Local/ElevatedDiagnostics/
**/AppData/Local/ElevatedDiagnostics/
**/AppData/Local/ElevatedDiagnostics/**/*
**/Application Data/
**/Local Settings/
**/Cookies/
**/My Documents/
**/NetHood/
**/PrintHood/
**/Recent/
**/SendTo/
**/Start Menu/
**/Templates/
**/*.tmp
**/*.temp
**/NTUSER.DAT*
**/ntuser.*
**/*.lnk
**/*.url
**/Service Worker/
**/CacheStorage/
**/xml_file (*).xml
**/ElevatedDiagnostics/
**/ElevatedDiagnostics/**/*

# Exclude problematic Windows system directories that cause permission errors
# These patterns match from any directory level
**/ElevatedDiagnostics/
**/ElevatedDiagnostics/**/*
**/Service Worker/
**/CacheStorage/
**/AppData/Local/ElevatedDiagnostics/
**/AppData/Local/ElevatedDiagnostics/**/*

